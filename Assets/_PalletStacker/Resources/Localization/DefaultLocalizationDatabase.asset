  m_Script: {fileID: 11500000, guid: af3d64f0dc2344f88bdc4e0f9594f27b, type: 3}
  m_Name: DefaultLocalizationDatabase
  m_EditorClassIdentifier: Assembly-CSharp::ElectricPalletStackers.Localization.LocalizationDatabase
  _entries:
  - _key: common.confirm
    _english: Press E-Stop to Confirm
    _vietnamese: "Nh\u1EA5n d\u1EEBng kh\u1EA9n c\u1EA5p \u0111\u1EC3 x\xE1c nh\u1EADn"
    _japanese: "\u975E\u5E38\u505C\u6B62\u30DC\u30BF\u30F3\u3067\u6C7A\u5B9A"
  - _key: common.continue
    _english: Press E-Stop to Continue
    _vietnamese: "Nh\u1EA5n d\u1EEBng kh\u1EA9n c\u1EA5p \u0111\u1EC3 ti\u1EBFp t\u1EE5c"
    _japanese: "\u975E\u5E38\u505C\u6B62\u30DC\u30BF\u30F3\u3067\u7D9A\u884C"
  - _key: calibration.title
    _english: Vehicle Calibration
    _vietnamese: "C\u0103n ch\u1EC9nh xe"
    _japanese: "\u8ECA\u4E21\u30AD\u30E3\u30EA\u30D6\u30EC\u30FC\u30B7\u30E7\u30F3"
  - _key: calibration.description
    _english: Adjust the controls until your view is aligned with the vehicle.
    _vietnamese: "\u0110i\u1EC1u ch\u1EC9nh c\u00E1c n\u00FAt \u0111\u1EBFn khi g\u00F3c nh\u00ECn c\u1EE7a b\u1EA1n kh\u1EDBp v\u1EDBi xe."
    _japanese: "\u8996\u70B9\u304C\u8ECA\u4E21\u306B\u5408\u3046\u3088\u3046\u306B\u64CD\u4F5C\u30DC\u30BF\u30F3\u3067\u8ABF\u6574\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - _key: language.english
    _english: English
    _vietnamese: "Ti\u1EBFng Anh"
    _japanese: "\u82F1\u8A9E"
  - _key: language.vietnamese
    _english: Vietnamese
    _vietnamese: "Ti\u1EBFng Vi\u1EC7t"
    _japanese: "\u30D9\u30C8\u30CA\u30E0\u8A9E"
  - _key: language.japanese
    _english: Japanese
    _vietnamese: "Ti\u1EBFng Nh\u1EADt"
    _japanese: "\u65E5\u672C\u8A9E"
  - _key: selectLanguage.title
    _english: Select Language
    _vietnamese: "Ch\u1ECDn ng\xF4n ng\u1EEF"
    _japanese: "\u8A00\u8A9E\u3092\u9078\u629E"
  - _key: selectLanguage.navigationHint
    _english: Use Travel to select language
    _vietnamese: "D\xF9ng c\u1EA7n di chuy\u1EC3n \u0111\u1EC3 ch\u1ECDn ng\xF4n
      ng\u1EEF"
    _japanese: "\u8D70\u884C\u30EC\u30D0\u30FC\u3067\u8A00\u8A9E\u3092\u9078\u629E"
  - _key: welcome.title
    _english: Welcome
    _vietnamese: "Ch\xE0o m\u1EEBng"
    _japanese: "\u3088\u3046\u3053\u305D"
  - _key: welcome.description
    _english: This training simulation recreates accident scenarios involving a walkie
      pallet stacker.
    _vietnamese: "M\xF4 ph\u1ECFng hu\u1EA5n luy\u1EC7n n\xE0y t\xE1i hi\u1EC7n c\xE1c
      t\xECnh hu\u1ED1ng tai n\u1EA1n li\xEAn quan \u0111\u1EBFn xe n\xE2ng tay cao
      ch\u1EA1y \u0111i\u1EC7n."
    _japanese: "\u3053\u306E\u8A13\u7DF4\u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u3067\u306F\u3001\u6B69\u884C\u64CD\u4F5C\u5F0F\u30D1\u30EC\u30C3\u30C8\u30B9\u30BF\u30C3\u30AB\u30FC\u306B\u95A2\u3059\u308B\u4E8B\u6545\u72B6\u6CC1\u3092\u518D\u73FE\u3057\u307E\u3059\u3002"
  - _key: guide.title
    _english: Guide
    _vietnamese: "H\u01B0\u1EDBng d\u1EABn"
    _japanese: "\u64CD\u4F5C\u30AC\u30A4\u30C9"
  - _key: guide.scrollHint
    _english: Use Travel to scroll
    _vietnamese: "D\xF9ng c\u1EA7n di chuy\u1EC3n \u0111\u1EC3 cu\u1ED9n"
    _japanese: "\u8D70\u884C\u30EC\u30D0\u30FC\u3067\u30B9\u30AF\u30ED\u30FC\u30EB"
  - _key: completed.title
    _english: Completed
    _vietnamese: "Ho\xE0n th\xE0nh"
    _japanese: "\u5B8C\u4E86"
  - _key: completed.description
    _english: You have successfully completed the training simulation.
    _vietnamese: "B\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh m\xF4 ph\u1ECFng hu\u1EA5n
      luy\u1EC7n."
    _japanese: "\u8A13\u7DF4\u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u3092\u5B8C\u4E86\u3057\u307E\u3057\u305F\u3002"
  - _key: failed.title
    _english: Failed
    _vietnamese: "Kh\xF4ng \u0111\u1EA1t"
    _japanese: "\u5931\u6557"
  - _key: failed.description
    _english: A collision was detected. The training simulation has failed.
    _vietnamese: "\u0110\xE3 ph\xE1t hi\u1EC7n va ch\u1EA1m. M\xF4 ph\u1ECFng hu\u1EA5n
      luy\u1EC7n kh\xF4ng \u0111\u1EA1t."
    _japanese: "\u885D\u7A81\u3092\u691C\u77E5\u3057\u307E\u3057\u305F\u3002\u8A13\u7DF4\u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u306F\u5931\u6557\u3067\u3059\u3002"
  - _key: phone.incomingCall
    _english: Incoming call
    _vietnamese: "Cu\u1ED9c g\u1ECDi \u0111\u1EBFn"
    _japanese: "\u7740\u4FE1"
  - _key: phone.inCall
    _english: In call
    _vietnamese: "\u0110ang g\u1ECDi"
    _japanese: "\u901A\u8A71\u4E2D"
  - _key: phone.tapToAnswer
    _english: Tap to answer
    _vietnamese: "Ch\u1EA1m \u0111\u1EC3 tr\u1EA3 l\u1EDDi"
    _japanese: "\u30BF\u30C3\u30D7\u3057\u3066\u5FDC\u7B54"
  - _key: phone.decline
    _english: Decline
    _vietnamese: "T\u1EEB ch\u1ED1i"
    _japanese: "\u62D2\u5426"
  - _key: phone.accept
    _english: Accept
    _vietnamese: "Ch\u1EA5p nh\u1EADn"
    _japanese: "\u5FDC\u7B54"
  - _key: phone.end
    _english: End
    _vietnamese: "K\u1EBFt th\xFAc"
    _japanese: "\u7D42\u4E86"
  - _key: ppe.title
    _english: Wear Safety Equipment
    _vietnamese: "Trang b\u1ECB b\u1EA3o h\u1ED9"
    _japanese: "\u4FDD\u8B77\u5177\u3092\u7740\u7528"
  - _key: ppe.description
    _english: Touch the safety helmet floating to your left before operating the
      vehicle.
    _vietnamese: "Ch\u1EA1m v\xE0o n\xF3n b\u1EA3o h\u1ED9 \u0111ang l\u01A1 l\u1EEDng
      b\xEAn tr\xE1i tr\u01B0\u1EDBc khi v\u1EADn h\xE0nh xe."
    _japanese: "\u8ECA\u4E21\u3092\u64CD\u4F5C\u3059\u308B\u524D\u306B\u3001\u5DE6\u5074\u306B\u6D6E\u304B\u3093\u3067\u3044\u308B\u5B89\u5168\u30D8\u30EB\u30E1\u30C3\u30C8\u306B\u89E6\u308C\u3066\u304F\u3060\u3055\u3044\u3002"
  - _key: crossSafety.instruction
    _english: Stop, point, and confirm it is safe to proceed.
    _vietnamese: "H\xE3y d\u1EEBng l\u1EA1i, ch\u1EC9 tay \u0111\u1EC3 x\xE1c nh\u1EADn an to\xE0n"
    _japanese: "\u505C\u6B62\u3057\u3001\u6307\u5DEE\u3057\u78BA\u8A8D\u3067\u5B89\u5168\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - _key: crossSafety.danger
    _english: Danger! Stop the vehicle immediately.
    _vietnamese: "Nguy hi\u1EC3m, d\u1EEBng xe l\u1EA1i ngay"
    _japanese: "\u5371\u967A\u3067\u3059\u3002\u76F4\u3061\u306B\u8ECA\u4E21\u3092\u505C\u6B62\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - _key: failed.reason.unknown
    _english: The run ended because a safety condition was violated.
    _vietnamese: "L\u01B0\u1EE3t hu\u1EA5n luy\u1EC7n k\u1EBFt th\xFAc do vi ph\u1EA1m
      \u0111i\u1EC1u ki\u1EC7n an to\xE0n."
    _japanese: "\u5B89\u5168\u6761\u4EF6\u306B\u9055\u53CD\u3057\u305F\u305F\u3081\u3001\u8A13\u7DF4\u3092\u7D42\u4E86\u3057\u307E\u3057\u305F\u3002"
  - _key: failed.continueCheckpoint
    _english: Continue from save point
    _vietnamese: "Ti\u1EBFp t\u1EE5c t\u1EEB \u0111i\u1EC3m l\u01B0u"
    _japanese: "\u30BB\u30FC\u30D6\u5730\u70B9\u304B\u3089\u7D9A\u884C"
  - _key: failed.exitRestart
    _english: Exit and restart
    _vietnamese: "Tho\xE1t v\xE0 b\u1EAFt \u0111\u1EA7u l\u1EA1i"
    _japanese: "\u7D42\u4E86\u3057\u3066\u6700\u521D\u304B\u3089\u3084\u308A\u76F4\u3059"
  - _key: failed.navigationHint
    _english: "Use Travel to select \u2022 Press E-Stop to confirm"
    _vietnamese: "D\xF9ng Travel \u0111\u1EC3 ch\u1ECDn \u2022 Nh\u1EA5n E-Stop \u0111\u1EC3
      x\xE1c nh\u1EADn"
    _japanese: "\u8D70\u884C\u30EC\u30D0\u30FC\u3067\u9078\u629E \u2022 \u975E\u5E38\u505C\u6B62\u30DC\u30BF\u30F3\u3067\u6C7A\u5B9A"
  - _key: resetGame.title
    _english: Reset Game
    _vietnamese: "\u0110\u1EB7t l\u1EA1i tr\xF2 ch\u01A1i"
    _japanese: "\u30B2\u30FC\u30E0\u3092\u30EA\u30BB\u30C3\u30C8"
  - _key: resetGame.restart
    _english: Restart
    _vietnamese: "Ch\u01A1i l\u1EA1i t\u1EEB \u0111\u1EA7u"
    _japanese: "\u6700\u521D\u304B\u3089\u3084\u308A\u76F4\u3059"
  - _key: resetGame.continue
    _english: Continue
    _vietnamese: "Ti\u1EBFp t\u1EE5c"
    _japanese: "\u7D9A\u3051\u308B"
  - _key: resetGame.resetPhase
    _english: Reset Current Phase
    _vietnamese: "\u0110\u1EB7t l\u1EA1i giai \u0111o\u1EA1n"
    _japanese: "\u73FE\u5728\u306E\u30D5\u30A7\u30FC\u30BA\u3092\u30EA\u30BB\u30C3\u30C8"
  - _key: resetGame.navigationHint
    _english: "Use Travel to select \u2022 Press E-Stop to confirm"
    _vietnamese: "D\xF9ng Travel \u0111\u1EC3 ch\u1ECDn \u2022 Nh\u1EA5n E-Stop \u0111\u1EC3
      x\xE1c nh\u1EADn"
    _japanese: "\u8D70\u884C\u30EC\u30D0\u30FC\u3067\u9078\u629E \u2022 \u975E\u5E38\u505C\u6B62\u30DC\u30BF\u30F3\u3067\u6C7A\u5B9A"
